# For `docker compose up`, the host must be the compose service name "postgres".
# For a local (non-Docker) run against a Postgres you started yourself, use "localhost" instead.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/agent_factory

# Mode A — Anthropic API key, for model_access "api_key" (see README "Model access").
# Leave unset to use FakeProvider/tests only, or mode B below.
ANTHROPIC_API_KEY=

# Mode B — the owner's own Claude subscription, for model_access "claude_account" (the default).
# Locally: run `claude` once and log in; no token needed here.
# In Docker/servers with no interactive login: `claude setup-token` prints a long-lived OAuth token — put it here.
CLAUDE_CODE_OAUTH_TOKEN=

# Mode C — a local Ollama server, for model_access "ollama" (free, no account).
# Locally: leave unset, defaults to http://localhost:11434.
# For `docker compose --profile ollama up`, use the compose service name: http://ollama:11434.
OLLAMA_BASE_URL=

# Mode D — OpenAI's own API, for an explicit per-role `models.<role>.provider: "openai"`
# (see README "Model access"). Leave unset unless a role is actually set to use it.
OPENAI_API_KEY=
