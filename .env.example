# With Docker (`docker compose up`) NOTHING here is required: this file is optional and every line has a working default
# (the database, the master secret — made once and kept in the data volume —, the port). Copy it to `.env` only to change
# something. Without Docker the app reads real environment variables, not this file.
#
# Only for a run WITHOUT Docker against a PostgreSQL you started yourself (unset = SQLite). Docker sets it by itself.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent_factory

# Mode A — Anthropic API key, for model_access "api_key" (see README "Model access").
# Leave unset to use FakeProvider/tests only, or mode B below.
ANTHROPIC_API_KEY=

# Mode B — the owner's own Claude subscription, for model_access "claude_account" (the default).
# Locally: run `claude` once and log in; no token needed here.
# In Docker/servers with no interactive login: `claude setup-token` prints a long-lived OAuth token — put it here.
CLAUDE_CODE_OAUTH_TOKEN=

# Mode C — a local Ollama server, for model_access "ollama" (free, no account).
# Locally: leave unset, defaults to http://localhost:11434.
# For `docker compose --profile ollama up`, use the compose service name: http://ollama:11434.
OLLAMA_BASE_URL=

# Mode D — OpenAI's own API, for an explicit per-role `models.<role>.provider: "openai"`
# (see README "Model access"). Leave unset unless a role is actually set to use it.
OPENAI_API_KEY=

# Sign-in (app/auth.py). An account made before sign-in existed is taken over once from the server's own machine; from
# anywhere else (e.g. a browser outside Docker, or behind a proxy) it needs this token. Leave empty to allow it only
# from the server's machine. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_FACTORY_OWNER_TOKEN=
# Set to 1 when the app is served over HTTPS behind a proxy that terminates TLS, so the session cookie is Secure.
AGENT_FACTORY_SECURE_COOKIE=
# Run workers inside the app (app/worker.py): threads that step bounded runs. 0 = none here, e.g. when a separate
# `python -m app.worker` process (or several) does the work.
AGENT_FACTORY_WORKERS=1
# The master secret that encrypts the provider keys added in Settings -> Connections (at least 32 characters; keep it out
# of the repository and back it up: without it the stored keys can't be read and have to be added again). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_FACTORY_SECRET_KEY=
# Rotating the master secret: put the NEW secret in AGENT_FACTORY_SECRET_KEY and the old one here, run
#   python -m app.credentials rotate
# (it re-encrypts every stored key and reports how many it could not open); when it says 0 unreadable, empty this line.
AGENT_FACTORY_SECRET_KEY_PREVIOUS=
# Set to 1 when a reverse proxy (nginx, a cloud load balancer...) fronts the server: the "claim from this machine" shortcut
# is then off (use AGENT_FACTORY_OWNER_TOKEN) and the session cookie is always Secure.
AGENT_FACTORY_BEHIND_PROXY=

# ---- Docker only (docker-compose.yml) ----
# Where the web UI is published. Default: this machine only. 0.0.0.0 = reachable from your network/phone (add HTTPS first).
AGENT_FACTORY_BIND=
AGENT_FACTORY_PORT=
# Password of the bundled PostgreSQL (it is not published outside Docker). Change it before the first start.
POSTGRES_PASSWORD=
# If Docker Hub answers 403 (it blocks some countries), pull the base images through a mirror, e.g.
#   PYTHON_IMAGE=mirror.gcr.io/library/python:3.11-slim
#   POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16
PYTHON_IMAGE=
POSTGRES_IMAGE=
# An Ollama installed on this machine (not in Docker) is reached from the container at:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
